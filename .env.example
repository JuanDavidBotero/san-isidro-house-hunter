# Local run configuration for the San Isidro radar. Copy to .env and fill in.
#
#   cp .env.example .env
#   chmod 600 .env
#
# .env is gitignored. run.sh loads it automatically, and the launchd job depends on
# it -- a scheduled job inherits almost no environment, so anything not in here is
# simply absent at 08:00.

# --- MercadoLibre: LEAVE THESE EMPTY ---------------------------------------
# Not needed. MercadoLibre's API returns 403 for search AND single-item lookup with
# both app- and user-context tokens (PA_UNAUTHORIZED_RESULT_FROM_POLICIES), so it is
# not a discovery source. Discovery is sweep.py. These exist only if you want to
# re-run the diagnostics in fetch_ml.py / tools/ml_probe.py to check whether
# MercadoLibre has reopened access.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=

# ML_REFRESH_TOKEN is deliberately absent: `fetch_ml.py --auth-login` writes it to
# data/ml_refresh_token, and MercadoLibre rotates it on every use, so the file is the
# source of truth and a value here would just go stale.

# --- Telegram (urgent alerts) -----------------------------------------------
# Create a bot with @BotFather, then get your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates after messaging the bot once.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email (daily digest, including the NO CHANGE proof-of-life) ------------
# For Gmail use an App Password, not your account password:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Comma-separated. Add your wife here once you trust the output.
EMAIL_TO=
